# Cloudflare R2（Laravel 用）
# ダッシュボード → R2 → Manage R2 API Tokens で発行

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mensesthe-rank-images
R2_ENDPOINT=https://6f95d4743ef87bea0b2e5142cf2a9738.r2.cloudflarestorage.com
# 本番: images.mensesthe-rank.jp（要 Cloudflare ゾーン追加、下記 setup-r2.sh 参照）
# 暫定: r2.dev（開発・検証用）
R2_PUBLIC_URL=https://images.mensesthe-rank.jp
# R2_PUBLIC_URL=https://pub-01e7da522ecd401f80dde51d5ed725ee.r2.dev

# Laravel filesystems.php の default（画像アップロード時）
FILESYSTEM_DISK=r2
